# Spotter Weather-Aware Truck Routing Environment Variables

# Django Application Settings
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=*
PORT=8000

# Providers Configuration
# ROUTING_PROVIDER: "tomtom" (requires key, with demo fallback) or "fixture"
ROUTING_PROVIDER=tomtom

# WEATHER_PROVIDER: "openmeteo" (live keyless API) or "fixture" (synthetic scenarios)
WEATHER_PROVIDER=openmeteo

# Demo Weather Scenario (for testing or fixture mode: S1_CLEAR, S2_WIND_FRONT, S3_SNOW_BAND, S4_ALL_BLOCKED, S5_MOVING_STORM)
DEMO_SCENARIO=S2_WIND_FRONT

# Optional Provider API Keys (leave empty for automatic keyless demo & Open-Meteo operation)
TOMTOM_API_KEY=
HERE_API_KEY=

# Persistence and Caching (defaults to local SQLite and in-memory cache)
DATABASE_URL=
REDIS_URL=
